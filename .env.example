# Optional. Without a key the robots use their reflex rules and every decision is labelled as such.
GEMINI_API_KEY=
# Model used by the robot agents and the dispatcher copilot. Any model listed for your key works,
# e.g. gemma-4-26b-a4b-it, gemma-4-31b-it or a Gemini model.
GEMMA_MODEL=gemma-4-26b-a4b-it
# Backup models tried in order when the main one errors or is slow (Google has busy spells).
AI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
# How many robots may wait on the model at the same time (keeps you inside API rate limits).
AI_MAX_PARALLEL=3
